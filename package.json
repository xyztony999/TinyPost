{
  "name": "tinypost",
  "version": "0.2.0",
  "description": "轻量本地 API 客户端（内网 / 信创可用）",
  "main": "./out/main/index.js",
  "author": {
    "name": "xyztony999",
    "email": "42613048+xyztony999@users.noreply.github.com"
  },
  "homepage": "https://github.com/xyztony999/TinyPost",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyztony999/TinyPost.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:linux-arm64": "npm run build && electron-builder --linux --arm64",
    "dist:deb": "bash scripts/pack-deb.sh"
  },
  "dependencies": {
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@rollup/wasm-node": "4.62.3",
    "@types/node": "^22.5.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^32.0.1",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rollup": "npm:@rollup/wasm-node@4.62.3",
    "typescript": "~5.8.3",
    "vite": "^5.4.3"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.62.3"
  }
}
